FROM ghcr.io/astral-sh/uv:0.11.2 AS uv
FROM python:3.13-slim
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv export --frozen --extra aws --no-dev --no-emit-project --format requirements-txt -o /tmp/requirements.txt && uv pip install --system --no-cache -r /tmp/requirements.txt
COPY services/agents ./services/agents
COPY fixtures ./fixtures
RUN useradd --uid 10001 --create-home agent
USER agent
EXPOSE 8080
CMD ["python","-m","services.agents.runtime"]
