FROM ghcr.io/astral-sh/uv:0.11.2 AS uv
FROM public.ecr.aws/awsguru/aws-lambda-adapter:1.0.1 AS lambda-adapter
FROM python:3.13-slim
COPY --from=lambda-adapter /lambda-adapter /opt/extensions/lambda-adapter
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv export --frozen --extra audio --no-dev --no-emit-project --format requirements-txt -o /tmp/requirements.txt && uv pip install --system --no-cache -r /tmp/requirements.txt
COPY services ./services
RUN useradd --uid 10001 --create-home audio
USER audio
ENV PORT=8080 \
    AWS_LWA_PORT=8080 \
    AWS_LWA_INVOKE_MODE=RESPONSE_STREAM \
    AWS_LWA_READINESS_CHECK_PATH=/healthz \
    AWS_LWA_ASYNC_INIT=true
EXPOSE 8080
CMD ["uvicorn", "services.audio.main:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]

