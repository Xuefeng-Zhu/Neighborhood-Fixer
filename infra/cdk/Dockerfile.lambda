FROM ghcr.io/astral-sh/uv:0.11.2 AS uv
FROM public.ecr.aws/lambda/python:3.13
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR ${LAMBDA_TASK_ROOT}
COPY pyproject.toml uv.lock ./
RUN uv export --frozen --extra aws --no-dev --no-emit-project --format requirements-txt -o /tmp/requirements.txt && uv pip install --system --no-cache -r /tmp/requirements.txt
COPY services ./services
COPY fixtures ./fixtures
COPY infra/cdk/bootstrap.py ./bootstrap.py
ENTRYPOINT ["python", "-m", "bootstrap"]
CMD ["services.api.main.handler"]
