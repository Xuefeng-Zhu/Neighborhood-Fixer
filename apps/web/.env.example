# Local mode needs no frontend environment values. Never put secrets here.
# Hosted AWS mode uses the Clerk development instance publishable key.
VITE_API_BASE_URL=
VITE_AWS_REGION=us-west-2
VITE_CLERK_PUBLISHABLE_KEY=
VITE_LOCATION_MAP_NAME=
# Only a public restricted GetMap key, scoped by map ARN, referrer and expiry:
VITE_LOCATION_API_KEY=
