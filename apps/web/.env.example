# Local mode needs no frontend environment values. Never put AWS secrets here.
# AWS mode: use deployment outputs and register the exact redirect URI in Cognito.
VITE_API_BASE_URL=
VITE_AWS_REGION=us-east-1
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=
VITE_LOCATION_MAP_NAME=
# Only a public restricted GetMap key, scoped by map ARN, referrer and expiry:
VITE_LOCATION_API_KEY=
