# Local startup generates private signing/service secrets under ignored .local/data.
NF_MODE=local
NF_ENVIRONMENT=development
NF_DATA_DIR=.local/data
NF_WEB_PORT=5173
NF_PORTAL_URL=http://127.0.0.1:8001
NF_PORTAL_ALLOWED_ORIGINS=http://127.0.0.1:8001
NF_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Configure AWS values via deployment outputs and Secrets Manager, never browser env.
# AWS_REGION=us-west-2
# NF_AUTH_PROVIDER=clerk
# NF_CLERK_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
# NF_AUTH_AUDIENCE=neighborhood-fixer-api
# NF_AUTHORIZED_PARTIES=https://YOUR_DEPLOYED_FRONTEND_ORIGIN
# NF_SHARED_WORKSPACE_ID=demo-borough-v1
# NF_DATA_GENERATION=clerk-v1
# NF_REPORTS_PER_DAY=10
# NF_UPLOADS_PER_DAY=25
# NF_REASONING_JOBS_PER_DAY=30
# NF_WORKSPACE_REPORTS_PER_DAY=100
# NF_WORKSPACE_UPLOADS_PER_DAY=250
# NF_WORKSPACE_REASONING_JOBS_PER_DAY=300
# Clerk secret keys never belong in Lambda, Vite, or committed environment files.
# AWS admission is initialized by scripts/manage_aws_demo.py, never by a browser.
# NF_BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
# NF_TABLE_NAME=
# NF_EVIDENCE_BUCKET=
# NF_PORTAL_TABLE=
# NF_AGENTCORE_RUNTIME_ARN=
# NF_AGENTCORE_BROWSER_ID=
# NF_STATE_MACHINE_ARN=
# NF_AGENT_TIMEOUT_SECONDS=120
# NF_AGENT_MAX_TURNS=8
# NF_AGENT_MAX_TOOLS=16
# NF_BROWSER_TIMEOUT_SECONDS=90
# NF_RUN_AWS_SMOKE=0
